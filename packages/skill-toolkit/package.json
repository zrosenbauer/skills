{
  "name": "@zrosenbauer/skill-toolkit",
  "version": "0.0.0",
  "private": true,
  "description": "CLI for authoring, linting, and evaluating skills in this monorepo",
  "license": "MIT",
  "author": "Zac Rosenbauer <zacrosenbauer@gmail.com>",
  "bin": {
    "skill-toolkit": "./dist/index.mjs"
  },
  "type": "module",
  "scripts": {
    "dev": "maltty dev",
    "build": "maltty build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .maltty coverage"
  },
  "dependencies": {
    "maltty": "1.0.0-rc.3",
    "massaman": "^0.5.5",
    "yaml": "^2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@maltty/cli": "1.0.0-rc.4",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
