{
  "name": "@zrosenbauer/skills",
  "version": "0.0.0",
  "private": true,
  "description": "Personal agent skills monorepo (SKILL.md format) — agent-agnostic, works with Claude Code, Cursor, Codex, and others",
  "license": "MIT",
  "author": "Zac Rosenbauer <zacrosenbauer@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/zrosenbauer/skills.git"
  },
  "scripts": {
    "build": "turbo run build",
    "bundle": "turbo run bundle",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "test": "turbo run test",
    "test:scripts": "node --test 'skills/*/scripts/*.test.mjs' '.agents/skills/*/scripts/*.test.mjs' 'skill-scripts/*/*.test.mjs' 'skill-scripts/*/src/*.test.mjs'",
    "audit:skills": "uvx snyk-agent-scan@latest --skills ./skills",
    "prepare": "lefthook install",
    "typecheck": "turbo run typecheck",
    "check": "pnpm lint && pnpm format && pnpm typecheck && pnpm test && pnpm test:scripts",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "skill-toolkit": "node packages/skill-toolkit/dist/index.mjs"
  },
  "devDependencies": {
    "lefthook": "^2.2.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "turbo": "^2.11.10"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.16.1"
}
